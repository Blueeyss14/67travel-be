{
  "version": 2,
  "outputDirectory": "./public",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.8.3"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    },
    {
      "src": "/public/build/(.*)",
      "dest": "/public/build/$1"
    },
    {
      "src": "/(css|js|images|assets)/(.*)",
      "dest": "/public/$1/$2"
    }
  ]
}
